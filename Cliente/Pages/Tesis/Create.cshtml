@page
@model ProjecBlazor.Pages.Tesis.CreateModel
@{
    ViewData["Title"] = "Registrar Nueva Tesis";
}

<style>
    :root {
        --magenta-primary: #d81b60;
        --magenta-dark: #880e4f;
        --magenta-light: #fce4ec;
        --magenta-accent: #ff4081;
        --magenta-gradient: linear-gradient(135deg, #ad1457 0%, #e91e63 100%);
    }

    .border-magenta {
        border-color: var(--magenta-primary) !important;
    }

    .text-magenta {
        color: var(--magenta-primary) !important;
    }

    .btn-magenta {
        background: var(--magenta-gradient);
        color: #ffffff !important;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-magenta:hover {
        background: linear-gradient(135deg, #880e4f 0%, #d81b60 100%);
        box-shadow: 0 4px 12px rgba(216, 27, 96, 0.35);
        transform: translateY(-2px);
    }

    .card-form {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 10px 30px rgba(216, 27, 96, 0.1);
        overflow: hidden;
    }

    .accent-bar {
        background: var(--magenta-gradient);
        height: 6px;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="card card-form bg-white">
            <div class="accent-bar"></div>
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center mb-4">
                    <div class="p-3 rounded-4 me-3 fs-3" style="background-color: var(--magenta-light); color: var(--magenta-primary);">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0">Registrar Nueva Tesis</h3>
                        <p class="text-muted small mb-0">Fila B: Registro académico con reglas de asignación y carga de imagen.</p>
                    </div>
                </div>

                <!-- Alerta de Error de Reglas de Negocio -->
                @if (Model.MensajeError is not null)
                {
                    <div class="alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                        <div>
                            <strong>Error en el registro:</strong>
                            <div>@Model.MensajeError</div>
                        </div>
                    </div>
                }

                <!-- Reglas de negocio visibles para el usuario -->
                <div class="alert rounded-4 mb-4 border-0" style="background-color: #fff0f6; border-left: 4px solid var(--magenta-primary) !important;">
                    <div class="fw-bold text-magenta mb-1">
                        <i class="bi bi-shield-lock-fill me-1"></i> Reglas de Validación Académica:
                    </div>
                    <ul class="mb-0 small text-muted ps-3">
                        <li><strong>No puede duplicarse la tesis:</strong> No se permiten dos tesis con el mismo título.</li>
                        <li><strong>Tutor solo puede tener 3 tesis:</strong> El sistema rechazará la asignación si el tutor seleccionado ya tiene 3 tesis.</li>
                    </ul>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <!-- Título de Tesis -->
                    <div class="mb-3">
                        <label asp-for="Tesis.Titulo" class="form-label fw-semibold">Título de la Tesis <span class="text-danger">*</span></label>
                        <input asp-for="Tesis.Titulo" class="form-control rounded-3 py-2" placeholder="Ej. Implementación de Sistema Inteligente..." required />
                        <span asp-validation-for="Tesis.Titulo" class="text-danger small"></span>
                        <div class="form-text">Debe ser un título único en la institución.</div>
                    </div>

                    <!-- Nombre del Estudiante -->
                    <div class="mb-3">
                        <label asp-for="Tesis.Estudiante" class="form-label fw-semibold">Nombre Completo del Estudiante <span class="text-danger">*</span></label>
                        <input asp-for="Tesis.Estudiante" class="form-control rounded-3 py-2" placeholder="Ej. Juan Carlos Pérez Gómez" required />
                        <span asp-validation-for="Tesis.Estudiante" class="text-danger small"></span>
                    </div>

                    <!-- Estado de la Tesis -->
                    <div class="mb-3">
                        <label asp-for="Tesis.Estado" class="form-label fw-semibold">Estado de la Tesis <span class="text-danger">*</span></label>
                        <select asp-for="Tesis.Estado" class="form-select rounded-3 py-2" required>
                            <option value="">-- Seleccionar Estado --</option>
                            <option value="En Desarrollo">En Desarrollo</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Revisión Final">Revisión Final</option>
                            <option value="Pendiente de Defensa">Pendiente de Defensa</option>
                            <option value="Defendida">Defendida</option>
                        </select>
                        <span asp-validation-for="Tesis.Estado" class="text-danger small"></span>
                    </div>

                    <!-- Asignación de Tutor -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Tesis.IdTutor" class="form-label fw-semibold mb-0">Tutor Asignado <span class="text-danger">*</span></label>
                            <a asp-page="/Tutores/Create" target="_blank" class="small text-magenta fw-semibold text-decoration-none">
                                <i class="bi bi-plus-circle"></i> Nuevo Tutor
                            </a>
                        </div>
                        <select asp-for="Tesis.IdTutor" class="form-select rounded-3 py-2" required>
                            <option value="">-- Seleccione un Tutor Académico --</option>
                            @foreach (var tut in Model.Tutores)
                            {
                                var disponible = tut.TotalTesis < 3;
                                <option value="@tut.Id" disabled="@(!disponible)">
                                    @tut.Nombre — @tut.Especialidad (@tut.TotalTesis/3 tesis asignadas) @(disponible ? "" : " [LÍMITE ALCANZADO]")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Tesis.IdTutor" class="text-danger small"></span>
                        <div class="form-text">Solo pueden seleccionarse tutores con menos de 3 tesis asignadas.</div>
                    </div>

                    <!-- 4) SUBIR IMAGENES -->
                    <div class="mb-4">
                        <label asp-for="ArchivoImagen" class="form-label fw-semibold">
                            <i class="bi bi-image text-magenta me-1"></i> Portada / Documento de la Tesis (Imagen)
                        </label>
                        <input asp-for="ArchivoImagen" type="file" class="form-control rounded-3 py-2" accept="image/*" onchange="previsualizarPortada(event)" />
                        <div class="form-text">Formatos permitidos: JPG, PNG, WEBP, JPEG.</div>

                        <div class="mt-3 text-center d-none" id="contenedorPreview">
                            <div class="small text-muted mb-1">Vista previa de la portada:</div>
                            <img id="imgPreview" src="#" alt="Previsualización" class="img-fluid rounded-4 shadow-sm border border-magenta" style="max-height: 220px; object-fit: cover;" />
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancelar</a>
                        <button type="submit" class="btn btn-magenta px-4 rounded-pill fw-semibold shadow-sm">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Guardar Tesis
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previsualizarPortada(event) {
            const input = event.target;
            const contenedor = document.getElementById('contenedorPreview');
            const preview = document.getElementById('imgPreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    contenedor.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
