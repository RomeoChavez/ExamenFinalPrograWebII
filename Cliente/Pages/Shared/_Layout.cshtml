<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjecBlazor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjecBlazor.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f4f9;
            color: #1e293b;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #0a2540 0%, #0d6efd 100%);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.15);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .hover-nav:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }

        .footer {
            background-color: #ffffff;
            font-size: 0.9rem;
            border-top: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-custom mb-4 py-3">
            <div class="container">
                <a class="navbar-brand text-white d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="bi bi-trophy-fill text-info"></i> ProjecBlazor
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4 gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 rounded-pill hover-nav" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 rounded-pill hover-nav" asp-area="" asp-page="/Canchas/Index">Canchas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 rounded-pill hover-nav fw-bold" style="background-color: #d81b60;" asp-area="" asp-page="/Tesis/Index">
                                <i class="bi bi-mortarboard-fill me-1"></i> Tesis (Tema B)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 rounded-pill hover-nav" asp-area="" asp-page="/Tutores/Index">
                                <i class="bi bi-person-workspace me-1"></i> Tutores
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3 rounded-pill hover-nav" asp-area="" asp-page="/Privacy">Privacidad</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-4 mt-auto">
        <div class="container text-center">
            &copy; 2026 - <span class="text-primary fw-semibold">ProjecBlazor</span> - Sistema de Reservas y Gestión Deportiva
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- GLightbox JS -->
    <script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>